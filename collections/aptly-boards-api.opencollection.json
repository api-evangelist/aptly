{
  "opencollection": "1.0.0",
  "info": {
    "name": "Aptly App Boards API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-token",
      "value": "{{x-token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Boards",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List boards",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://core-api.getaptly.com/api/boards",
            "auth": {
              "type": "apikey",
              "key": "x-token",
              "value": "{{x-token}}",
              "placement": "header"
            }
          },
          "docs": "Returns all boards in your company that have API access enabled.\nEach board includes its UUID, display name, and a list of pre-built endpoint URLs\nyou can use to interact with cards on that board.\n\nAccepts an API key (`x-token`) or a delegate token (`Authorization: DelegateToken <token>`).\n"
        }
      ]
    }
  ],
  "bundled": true
}