      "item": [
        {
          "id": "f31fabb4-e765-4a3e-aa65-21b174362bb5",
          "name": "List unsent drafts on an inbox",
          "request": {
            "name": "List unsent drafts on an inbox",
            "description": {
              "content": "Returns the unsent drafts on the given email inbox. The inbox is identified\nby its `channelId` — the same value returned as `channelId` from\n`GET /api/users/{userId}/inboxes`.\n\nEach item in the response is a draft entry with the parent discussion's\n`streamId` attached. Drafts currently in the process of sending (after\n`POST /api/email/send` was called and before the upstream provider accepts\nthe message) are excluded.\n\nWith API-key auth the only scope check is that the inbox belongs to your\ncompany. With delegate-token auth (`email:*` scope) the inbox must also be\none the authenticated user can reach personally or via a team membership.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "inboxes",
                ":channelId",
                "drafts"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "channelId",
                  "description": "(Required) External channel meta ID (`meta.id`) of the inbox."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "x-token"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            }
          },
          "response": [
            {
              "id": "17e072cf-ff1d-487b-82aa-746957fec020",
