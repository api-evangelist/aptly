          "id": "03a8b1e5-ccfd-481e-84aa-966084b265cf",
          "name": "Verify a delegate token (keyless)",
          "request": {
            "name": "Verify a delegate token (keyless)",
            "description": {
              "content": "Validates a short-lived delegate token without requiring an API key. The token must\ninclude an `appClientId` (i.e. it was issued for an embedded app via\n`POST /api/platform/user-token`). Returns the user's identity, company name, and\nthe app's title.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "app",
                "verify"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
