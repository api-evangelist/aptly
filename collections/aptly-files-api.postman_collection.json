                  "raw": "{\n  \"name\": \"invoice.pdf\",\n  \"extension\": \"pdf\",\n  \"size\": 20480,\n  \"contentType\": \"application/pdf\",\n  \"attachEntityType\": \"channel\",\n  \"attachEntityId\": \"7f3c2a1b9d4e5f6a7b8c9d0e\"\n}",
                  "options": {
