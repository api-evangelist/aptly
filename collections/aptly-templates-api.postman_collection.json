        {
          "id": "9f5d63dd-cd2a-436a-8f3d-e2fc55ce9934",
          "name": "List templates",
          "request": {
            "name": "List templates",
            "description": {
              "content": "Returns communication templates for the company. All filter parameters are optional.\n\nAccepts an API key (`x-token`), delegate token (`Authorization: DelegateToken <token>`),\nor partner token (`Authorization: Bearer <token>` with `templates` permission).\nWhen using a partner token, pass `companyId` as a query parameter.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "templates"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "companyId",
                  "value": "<string>",
                  "description": "Company ID. Required when using a partner token; resolved automatically for API key and delegate token auth."
                },
                {
                  "disabled": false,
                  "key": "templateType",
                  "value": "<string>",
                  "description": "Filter by template type."
                },
                {
                  "disabled": false,
                  "key": "aptletUuid",
                  "value": "<string>",
                  "description": "Filter by associated board UUID."
                },
                {
                  "disabled": false,
                  "key": "archived",
                  "value": "<boolean>",
                  "description": "Filter by archived status."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "x-token"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            }
          },
