              "raw": "{\n  \"userIds\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"isChecked\": \"<boolean>\",\n  \"isPinned\": \"<boolean>\",\n  \"archived\": false,\n  \"taskPriority\": \"<string>\",\n  \"streamId\": \"<string>\",\n  \"channelId\": \"<string>\",\n  \"aptletUuid\": \"<string>\",\n  \"aptletInstanceId\": \"<string>\",\n  \"leaderboard\": \"<boolean>\",\n  \"onlyAssigned\": \"<boolean>\",\n  \"unAssigned\": \"<boolean>\",\n  \"useCount\": \"<boolean>\",\n  \"limit\": 1000,\n  \"dueAt\": {\n    \"startDate\": \"<dateTime>\",\n    \"endDate\": \"<dateTime>\"\n  },\n  \"checkedAt\": {\n    \"startDate\": \"<dateTime>\",\n    \"endDate\": \"<dateTime>\"\n  },\n  \"updatedAt\": {\n    \"startDate\": \"<dateTime>\",\n    \"endDate\": \"<dateTime>\"\n  }\n}",
