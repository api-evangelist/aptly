            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"<string>\",\n  \"assigneeId\": \"<string>\",\n  \"dueAt\": \"<dateTime>\",\n  \"type\": \"<string>\",\n  \"userId\": \"<string>\",\n  \"note\": \"<string>\",\n  \"status\": \"<string>\",\n  \"priority\": \"<string>\",\n  \"logType\": \"<string>\",\n  \"aptletInstanceId\": \"<string>\",\n  \"aptletUuid\": \"<string>\",\n  \"channelId\": \"<string>\",\n  \"streamId\": \"<string>\",\n  \"fieldId\": \"<string>\",\n  \"attachmentIds\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"references\": [\n    \"<object>\",\n    \"<object>\"\n  ]\n}",
